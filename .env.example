HOST=0.0.0.0
PORT=3000
PS5_CAFE_API_TOKEN=replace-with-a-long-random-token
PS5_CAFE_DB_PATH=./data/ps5-cafe.sqlite
# false = live: real TVs that only show their screen pages (no TV control yet). Live mode needs its own database file
# (default ./data/ps5-cafe-live.sqlite) and a token of 16+ characters. scripts/start-live.sh sets all of this up.
SIMULATION_MODE=true
STATION_COUNT=10
# Advertising images and videos shown on idle TVs (default: media/ beside the database file).
# PS5_CAFE_MEDIA_DIR=./data/media
# Upper bound for one TV command in ms (100-60000, default 5000). Slower commands are recorded as TIMEOUT.
# PS5_CAFE_COMMAND_TIMEOUT_MS=5000
# How long a QR reservation holds a TV for the customer to pay at the counter (1-60 minutes, default 10).
# PS5_CAFE_RESERVATION_HOLD_MINUTES=10
