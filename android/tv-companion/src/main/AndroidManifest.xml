<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Loads the LAN screen page. No other permission is needed for the screen itself. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Optional best-effort relaunch after boot. Unverified per model; restricted on Android 10+. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!--
        Session timer overlay (informational only, not a lock). SYSTEM_ALERT_WINDOW is an app-op:
        Android TV usually hides its settings page, so it is granted over ADB with
        `adb shell appops set com.ps5cafe.tvcompanion SYSTEM_ALERT_WINDOW allow`.
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Installable on Android TV / Google TV and, for bench testing, on phones. -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <!-- Implied by screenOrientation="landscape"; not required so no TV build is filtered out. -->
    <uses-feature
        android:name="android.hardware.screen.landscape"
        android:required="false" />

    <!--
        Package visibility (targetSdk 30+): lets the Diagnostics screen see which TV app would
        handle a passthrough-input VIEW intent before it is fired.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data
                android:host="android.media.tv"
                android:scheme="content" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Ps5Cafe"
        tools:targetApi="31">

        <!-- No WebView usage metrics are sent from this app (no analytics). -->
        <meta-data
            android:name="android.webkit.WebView.MetricsOptOut"
            android:value="true" />

        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            tools:ignore="DiscouragedApi,LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SetupActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.Ps5Cafe.Panel"
            android:windowSoftInputMode="adjustResize|stateHidden"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <activity
            android:name=".DiagnosticsActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.Ps5Cafe.Panel"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <!-- Polls this station's status and draws the remaining-time box over the TV picture. -->
        <service
            android:name=".TimerOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Shows remaining gaming-session time over the TV picture" />
        </service>

        <!--
            Not exported: BOOT_COMPLETED is sent by the system, which may deliver to
            non-exported receivers; no other app can trigger it.
        -->
        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
