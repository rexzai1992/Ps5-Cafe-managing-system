<?xml version="1.0" encoding="utf-8"?>
<!-- High-contrast focus ring so the D-pad position is obvious from across the room. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent" />
            <stroke
                android:width="4dp"
                android:color="@color/focus" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/control_bg" />
            <stroke
                android:width="1dp"
                android:color="@color/control_border" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
