<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Screen page: full screen, black, no action bar. -->
    <style name="Theme.Ps5Cafe" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/screen_bg</item>
        <item name="android:colorPrimary">@color/accent</item>
        <item name="android:colorPrimaryDark">@color/screen_bg</item>
        <item name="android:colorAccent">@color/accent</item>
    </style>

    <!-- Setup and Diagnostics: not fullscreen so adjustResize works with the on-screen keyboard. -->
    <style name="Theme.Ps5Cafe.Panel" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/panel_bg</item>
        <item name="android:colorPrimary">@color/accent</item>
        <item name="android:colorPrimaryDark">@color/panel_bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_dim</item>
    </style>

    <style name="Ps5Cafe.Button" parent="@android:style/Widget.Material.Button">
        <item name="android:background">@drawable/bg_button</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">18sp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Ps5Cafe.Field" parent="@android:style/Widget.Material.EditText">
        <item name="android:background">@drawable/bg_field</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_dim</item>
        <item name="android:textSize">20sp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="Ps5Cafe.Label" parent="@android:style/TextAppearance.Material.Body1">
        <item name="android:textColor">@color/text_dim</item>
        <item name="android:textSize">16sp</item>
    </style>
</resources>
