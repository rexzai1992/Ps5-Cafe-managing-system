<?xml version="1.0" encoding="utf-8"?>
<!-- Root stays a FrameLayout (not <merge>) because it carries keepScreenOn. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true"
    tools:ignore="MergeRootFrame">

    <!-- The WebView is created in code because creation fails on TVs without System WebView. -->
    <FrameLayout
        android:id="@+id/web_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Opaque native overlay: hides the browser error page while the server is unreachable. -->
    <LinearLayout
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/overlay_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="96dp"
        android:paddingTop="54dp"
        android:paddingEnd="96dp"
        android:paddingBottom="54dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/overlay_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/text_primary"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/overlay_detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:textColor="@color/text_dim"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/overlay_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:textColor="@color/text_dim"
            android:textSize="18sp" />
    </LinearLayout>
</FrameLayout>
