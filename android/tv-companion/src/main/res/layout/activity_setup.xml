<?xml version="1.0" encoding="utf-8"?>
<!-- 48dp/27dp padding keeps everything inside the TV overscan-safe area. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingTop="27dp"
        android:paddingEnd="48dp"
        android:paddingBottom="27dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setup_title"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            style="@style/Ps5Cafe.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/setup_intro" />

        <TextView
            android:id="@+id/setup_current"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <TextView
            style="@style/Ps5Cafe.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:labelFor="@+id/setup_server"
            android:text="@string/setup_server_label" />

        <EditText
            android:id="@+id/setup_server"
            style="@style/Ps5Cafe.Field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionNext|flagNoExtractUi"
            android:importantForAutofill="no"
            android:inputType="textUri"
            tools:ignore="UnusedAttribute" />

        <TextView
            style="@style/Ps5Cafe.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:labelFor="@+id/setup_station"
            android:text="@string/setup_station_label" />

        <EditText
            android:id="@+id/setup_station"
            style="@style/Ps5Cafe.Field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionNext|flagNoExtractUi"
            android:importantForAutofill="no"
            android:inputType="text|textNoSuggestions|textVisiblePassword"
            tools:ignore="UnusedAttribute" />

        <TextView
            style="@style/Ps5Cafe.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:labelFor="@+id/setup_key"
            android:text="@string/setup_key_label" />

        <EditText
            android:id="@+id/setup_key"
            style="@style/Ps5Cafe.Field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionDone|flagNoExtractUi"
            android:importantForAutofill="no"
            android:inputType="text|textNoSuggestions|textVisiblePassword"
            tools:ignore="UnusedAttribute" />

        <CheckBox
            android:id="@+id/setup_boot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_focus_outline"
            android:minHeight="48dp"
            android:padding="8dp"
            android:text="@string/setup_boot_label"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/setup_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/error"
            android:textSize="18sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/setup_save"
                style="@style/Ps5Cafe.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setup_save" />

            <Button
                android:id="@+id/setup_diagnostics"
                style="@style/Ps5Cafe.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/setup_diagnostics" />

            <Button
                android:id="@+id/setup_cancel"
                style="@style/Ps5Cafe.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/setup_cancel" />
        </LinearLayout>

        <TextView
            style="@style/Ps5Cafe.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/setup_kiosk_note"
            android:textColor="@color/warning" />

        <TextView
            android:id="@+id/setup_version"
            style="@style/Ps5Cafe.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
